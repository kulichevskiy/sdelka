# SITE_ADDRESS вычисляется в docker-entrypoint.sh: ":80" без домена, иначе домен с авто-HTTPS
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Хэшированные ассеты Vite можно кэшировать навсегда
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
