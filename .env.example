# Скопируйте в .env и поменяйте секреты.
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm

# Публичный адрес приложения: используется в ссылках приглашений и сброса пароля.
APP_URL=http://localhost:8080
# Домен для автоматического HTTPS через Caddy. Пусто — обычный HTTP на HTTP_PORT.
DOMAIN=
HTTP_PORT=8080
HTTPS_PORT=8443

DEBUG=false

# Почта (необязательно). Если SMTP_HOST пуст, ссылки приглашений показываются админу в интерфейсе.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Сделка <noreply@sdelka.app>
