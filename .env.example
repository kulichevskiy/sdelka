# Скопируйте в .env и поменяйте секреты.
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm

# Публичный адрес приложения: используется в ссылках приглашений и сброса пароля.
APP_URL=http://localhost:8080
# Домен для автоматического HTTPS через Caddy. Пусто — обычный HTTP на HTTP_PORT.
DOMAIN=
HTTP_PORT=8080
HTTPS_PORT=8443

DEBUG=false

# Почта (необязательно). Без неё ссылки приглашений показываются админу в интерфейсе, а
# регистрация не требует подтверждения почты. С почтой новый аккаунт входит только после
# перехода по ссылке из письма. Адрес отправителя в обоих вариантах — SMTP_FROM.
#
# Вариант 1. Yandex Cloud Postbox по HTTPS — работает и там, где хостинг закрывает
# исходящий SMTP. Нужен статический ключ доступа сервисного аккаунта с ролью postbox.sender
# из того же каталога, что и адрес Postbox. Если ключи заданы, SMTP не используется.
POSTBOX_KEY_ID=
POSTBOX_SECRET_KEY=

# Вариант 2. Любой SMTP: порт 587 — STARTTLS, 465 — TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Сделка <noreply@sdelka.app>
